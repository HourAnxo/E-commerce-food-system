# Copy to .env and set real passwords before `docker compose up`.
# .env is read automatically by docker compose (keep it out of git).
MYSQL_ROOT_PASSWORD=change_me_root_pw
DB_USERNAME=foodapp
DB_PASSWORD=change_me_app_pw

# Bakong KHQR — your real Bakong account id (e.g. yourname@aclb) and the API token
# from https://api-bakong.nbc.gov.kh. Leave empty to disable Bakong checkout (503).
BAKONG_ACCOUNT_ID=
BAKONG_API_TOKEN=
BAKONG_MERCHANT_NAME=Food System
BAKONG_MERCHANT_CITY=Phnom Penh
